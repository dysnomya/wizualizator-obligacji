<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.github.dysnomya.wizualizatorobligacji.DatabaseViewController"
      spacing="20.0">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <VBox>
        <Label text="Nazwa obligacji:"/>
        <TextField fx:id="idField"/>
    </VBox>

    <VBox>
        <Label text="Koszt przedwczesnego wykupienia:"/>
        <TextField fx:id="earlyRedemptionCostField"/>
    </VBox>

    <VBox>
        <Label text="Oprocentowanie:"/>
        <TextField fx:id="interestRateField"/>
    </VBox>

    <Button text="Save" onAction="#handleSaveBond"/>
</VBox>
