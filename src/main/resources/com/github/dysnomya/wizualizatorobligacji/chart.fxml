<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<LineChart xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.github.dysnomya.wizualizatorobligacji.ChartController"
           createSymbols="false">
    <xAxis>
        <NumberAxis fx:id="xAxis" label="Czas"/>
    </xAxis>
    <yAxis>
        <NumberAxis fx:id="yAxis" label="Wartość"/>
    </yAxis>

</LineChart>
