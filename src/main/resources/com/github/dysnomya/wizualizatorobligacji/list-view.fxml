<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.github.dysnomya.wizualizatorobligacji.controllers.ListViewController">
    <center>
        <TabPane>
            <Tab text="TOS">
                <ListView fx:id="tosBonds"/>
            </Tab>
        </TabPane>

    </center>

    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <Button text="Refresh" onAction="#setListView"/>
            <Button text="Load API" onAction="#loadFromAPI"/>
        </ToolBar>

    </right>
</BorderPane>
